{
  "manifest_version": 3,
  "name": "Studielogboek",
  "version": "1.0.0",
  "description": "Houdt bij welke pagina's, video's en zoekopdrachten je bekijkt tijdens Studiemodus. Alles blijft lokaal op je pc.",
  "browser_specific_settings": {
    "gecko": {
      "id": "studielogboek@vakar.local",
      "strict_min_version": "128.0",
      "data_collection_permissions": { "required": ["none"] }
    }
  },
  "permissions": ["tabs", "storage", "alarms", "idle"],
  "host_permissions": ["<all_urls>"],
  "background": { "scripts": ["background.js"] },
  "action": {
    "default_title": "Studielogboek",
    "default_popup": "popup/popup.html",
    "default_icon": { "16": "icons/off-16.png", "32": "icons/off-32.png" }
  },
  "icons": { "48": "icons/on-48.png", "96": "icons/on-96.png" },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content/meta.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["*://*.youtube.com/*"],
      "js": ["content/youtube.js"],
      "run_at": "document_idle"
    }
  ]
}
